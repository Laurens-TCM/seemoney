# Copy to .env.local and fill in. Never commit .env.local.
# Used by the app (also add these two to Vercel):
# The project URL only, e.g. https://abcd1234.supabase.co (no /rest/v1/ on the end)
VITE_SUPABASE_URL=
# Publishable key (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=
# Local only. Never add to Vercel, GitHub or CI:
# Secret key (sb_secret_...), used only by the RLS tests
SUPABASE_SERVICE_ROLE_KEY=
# Project-scoped access token: Project read, Database read and write. Expires; regenerate as needed.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
